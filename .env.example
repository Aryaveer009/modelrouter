# ModelRouter configuration. Copy to .env and fill in. Any OpenAI-compatible
# provider works (OpenAI, Groq, Together, OpenRouter, vLLM, Ollama, ...).
# Author: Aryaveer Mankotia (https://github.com/Aryaveer009)

# --- Cheap model ---------------------------------------------------------
CHEAP_MODEL=gpt-4o-mini
CHEAP_BASE_URL=https://api.openai.com/v1
CHEAP_API_KEY=
# USD per 1M tokens. Check your provider's current price list: these are
# examples, and ModelRouter's cost numbers are only as right as these values.
CHEAP_PRICE_IN_PER_M=0.15
CHEAP_PRICE_OUT_PER_M=0.60
# Optional JSON merged into every request (e.g. reasoning models: {"reasoning_effort":"low"})
CHEAP_EXTRA_BODY=

# --- Strong model --------------------------------------------------------
STRONG_MODEL=gpt-4o
STRONG_BASE_URL=https://api.openai.com/v1
STRONG_API_KEY=
STRONG_PRICE_IN_PER_M=2.50
STRONG_PRICE_OUT_PER_M=10.00
STRONG_EXTRA_BODY=

# Example of mixing providers (Groq, OpenAI-compatible):
#   CHEAP_MODEL=llama-3.1-8b-instant
#   CHEAP_BASE_URL=https://api.groq.com/openai/v1
#   STRONG_MODEL=llama-3.3-70b-versatile
#   STRONG_BASE_URL=https://api.groq.com/openai/v1

# --- Routing -------------------------------------------------------------
# Use the cheap model only when P(query is easy) >= this value.
# Higher = more conservative (more traffic goes to the strong model).
ROUTER_CONFIDENCE_THRESHOLD=0.5
# embedding (logistic regression on sentence embeddings) | heuristic (baseline)
ROUTER_CLASSIFIER=embedding
ROUTER_CLASSIFIER_PATH=models/classifier.json
# Escalate to the strong model when the cheap answer looks uncertain/invalid.
ROUTER_FALLBACK=1
# Optional: also escalate if mean token logprob is below this (needs provider
# logprobs support). Leave empty to disable.
ROUTER_MIN_AVG_LOGPROB=

# --- Runtime -------------------------------------------------------------
# 1 = no network, deterministic fake models (tests, demos). Never used for README numbers.
MODELROUTER_MOCK=0
MODELROUTER_DB=modelrouter.db
# 1 = store the first 300 chars of each query in SQLite for the dashboard.
MODELROUTER_LOG_QUERIES=1
MODELROUTER_TIMEOUT_S=60
